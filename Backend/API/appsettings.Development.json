{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "plannerapi",
    "Audience": "account",
    "ExpirationInMinutes": 15
  },
  "RefreshToken": {
    "ExpirationInDays": 2
  },
  "CorsPolicy": {
    "PolicyName": "ClientApp",
    "AllowedOrigins": [
      "https://localhost:3000"
    ]
  }
}
