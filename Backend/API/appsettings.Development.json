{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "plannerapi",
    "Audience": "account",
    "ExpirationInMinutes": 20
  },
  "RefreshToken": {
    "ExpirationInDays": 2
  },
  "PasswordResetToken": {
    "ExpirationInMinutes":  15
  },
  "CorsPolicy": {
    "PolicyName": "ClientApp",
    "AllowedOrigins": [
      "https://localhost:3000"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "plannerexample@gmail.com",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "PlannerExample"
  },
  "FrontEndLinks": {
    "ResetPassword": "https://localhost:3000/reset-password"
  },
  "InvitationConfigurations": {
    "ExpirationInMinutes": 15
  }
}
