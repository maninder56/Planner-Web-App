{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
    }
  },
  "Jwt": {
    "Issuer": "plannerapi",
    "Audience": "https://plannerexample.co.uk/api",
    "ExpirationInMinutes": 15
  },
  "RefreshToken": {
    "ExpirationInDays": 5
  },
  "PasswordResetToken": {
    "ExpirationInMinutes":  15
  },
  "CorsPolicy": {
    "PolicyName": "ClientApp",
    "AllowedOrigins": [
      "https://plannerexample.co.uk",
      "https://www.plannerexample.co.uk"
    ]
  },
  "EmailSettings": {
    "SenderEmail": "plannerexample@gmail.com",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "PlannerExample"
  },
  "FrontEndLinks": {
    "ResetPassword": "https://www.plannerexample.co.uk/reset-password"
  },
  "InvitationConfigurations": {
    "ExpirationInMinutes": 15
  }
